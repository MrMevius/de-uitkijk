# Copy to .env (git-ignored). Never commit .env.

# --- Mode -------------------------------------------------------------------
# mock: simulated cameras and alerts (default). live: real Frigate alerts and camera streams.
UITKIJK_MODE=mock
# Camera list in config/: cameras.json (4 locations) or cameras-9.mock.json (nine, mock only).
UITKIJK_CAMERA_FILE=cameras.json
# Mock scenario at start-up: demo, idle, single-alert, multi-alert, expire-reactivate,
# camera-disconnect, frigate-unavailable, streaming-unavailable, nine-cameras.
UITKIJK_MOCK_SCENARIO=demo

# --- Edge proxy ---------------------------------------------------------------
# Keep 127.0.0.1 unless you deliberately test from another machine on a trusted network.
UITKIJK_BIND=127.0.0.1
UITKIJK_PORT=8080

# --- Live mode ------------------------------------------------------------------
# Frigate API base URL reachable from the server container (read-only use). No credentials in the URL.
FRIGATE_URL=http://frigate.example.lan:5000
FRIGATE_POLL_MS=2000

# go2rtc config file in go2rtc/: mock.yaml or live.yaml (copy from live.example.yaml).
GO2RTC_CONFIG=mock.yaml

# Camera access for go2rtc only (live mode). URL-encode special characters. Keep .env at mode 600.
CAMERA_USER=
CAMERA_PASSWORD=
CAM_OPRIT_HOST=
CAM_VOORDEUR_HOST=
CAM_ACHTER_1_HOST=
CAM_ACHTER_2_HOST=
