# Edge proxy for De Uitkijk.
# - Serves the dashboard and forwards /api/ to the backend (which requires a login in live mode).
# - Exposes exactly one go2rtc endpoint: the MSE WebSocket, for validated stream names and logged-in
#   users only. The go2rtc management API, RTSP, and source URLs are never reachable through this proxy.
# - Two listeners with the same rules:
#     8080  on the host (deployment health check; not meant for viewing)
#     8081  for SWAG (https://uitkijk.mrmevius.nl, the one address for viewers)
# ${API_UPSTREAM} and ${GO2RTC_UPSTREAM} are filled in by the nginx image's envsubst at start-up.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Successful video login checks, per session cookie. Fresh for one minute; while the backend is down a
# previous success stays usable for up to four hours, so TVs can reconnect during a backend outage.
proxy_cache_path /var/cache/nginx/uitkijk-auth levels=1 keys_zone=uitkijk_auth:1m max_size=10m inactive=4h use_temp_path=off;

server {
    listen 8080;
    set $uitkijk_client $remote_addr;
    include /etc/nginx/conf.d/uitkijk-common.inc;
}

server {
    listen 8081;
    # SWAG is the only client here; it passes the real client address for login throttling.
    set $uitkijk_client $http_x_real_ip;
    include /etc/nginx/conf.d/uitkijk-common.inc;
}
