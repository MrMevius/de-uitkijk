# Edge proxy for De Uitkijk (development and reference for the later SWAG configuration).
# - Serves the dashboard.
# - Forwards /api/ to the backend.
# - Exposes exactly one go2rtc endpoint: the MSE WebSocket, for validated stream names only.
#   The go2rtc management API, RTSP, and source URLs are never reachable through this proxy.
# ${API_UPSTREAM} and ${GO2RTC_UPSTREAM} are filled in by the nginx image's envsubst at start-up.

# Client allowlist, generated at start-up from UITKIJK_ALLOW_FROM (see 05-uitkijk-allowlist.sh).
geo $uitkijk_allowed {
    default 0;
    include /etc/nginx/uitkijk-allow.geo;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8080;
    server_tokens off;
    root /usr/share/nginx/html;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    location / {
        if ($uitkijk_allowed = 0) {
            return 403;
        }
        try_files $uri /index.html;
    }

    location = /index.html {
        if ($uitkijk_allowed = 0) {
            return 403;
        }
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff always;
    }

    # Health status only (no camera or alert data); open so local health checks work.
    location = /api/health {
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    location /api/ {
        if ($uitkijk_allowed = 0) {
            return 403;
        }
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        # Server-sent events: no buffering, long-lived.
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    location = /stream/ws {
        if ($uitkijk_allowed = 0) {
            return 403;
        }
        if ($arg_src !~ "^[a-z0-9_]{1,64}$") {
            return 400;
        }
        # Rewrite (query string kept) instead of variables in proxy_pass, which would need a resolver.
        rewrite ^ /api/ws break;
        proxy_pass http://${GO2RTC_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # go2rtc compares the WebSocket Origin with Host.
        proxy_set_header Host $http_host;
        proxy_read_timeout 1h;
        proxy_buffering off;
    }
}
